{
  "name": "reform-hyperframes",
  "version": "4.0.0",
  "private": true,
  "description": "HyperFrames production pipeline for the Reform hackathon demo",
  "scripts": {
    "narration": "node generate-narration.js",
    "bridge": "node generate-bridge.js",
    "align": "node align-audio.js",
    "render": "VIDEO_FPS=30 node render-demo.js",
    "render:fast": "VIDEO_FPS=10 node render-demo.js",
    "render:cinematic": "VIDEO_FPS=30 VIDEO_CRF=14 VIDEO_PRESET=slow node render-demo.js",
    "render:resume": "RESUME=1 VIDEO_FPS=30 node render-demo.js",
    "render:audio": "VIDEO_FPS=30 AUDIO_ONLY=1 node render-demo.js",
    "verify": "ffprobe -v error -show_entries format=filename,duration,size:format_tags=title,artist,comment:stream=index,codec_name,codec_type,width,height,r_frame_rate,sample_rate,channels -of default=noprint_wrappers=1 out/reform-hackathon-demo.mp4"
  },
  "dependencies": {
    "puppeteer": "^25.9.0"
  }
}
