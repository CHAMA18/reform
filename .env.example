# ===========================================
# Reform — Environment Variables
# ===========================================
# Copy this file to .env and adjust the values.
#
#   cp .env.example .env

# --------------------------------------------------
# Docker Compose (optional)
# --------------------------------------------------
# If using docker compose, most services are configured automatically.
# Only Xano credentials need to be set in .env for the app container.
#
# Quick start with Docker:
#   docker compose up -d                    # Start everything
#   docker compose exec ollama ollama pull qwen2.5-coder:7b  # Download LLM (~500MB)
#   # Wait for Whisper model download (~150MB on first run)
#   # Open http://localhost:3000
#
# Services:
#   App:      http://localhost:3000    — Reform web app
#   Ollama:   http://localhost:11434   — Local LLM (form generation, insights, etc.)
#   Whisper:  http://localhost:9000    — Local ASR (voice transcription)
#   Postgres: localhost:5432           — Database
#
# Without Docker (local dev):
#   ./scripts/setup-local-llm.sh       # Install Ollama + pull model
#   ./scripts/start-whisper.sh         # Start Whisper server
#   npm run dev                        # Start Reform app

# --------------------------------------------------
# Xano Backend (required)
# --------------------------------------------------
# The metadata API token is generated in Xano Studio:
#   Profile icon → Instances → ⚙️ → Metadata API → Manage Access Tokens

# Xano Metadata API base URL — your instance's /api:meta path
XANO_INSTANCE_API=https://your-instance.xano.io/api:meta

# Xano Metadata API access token (Bearer token)
XANO_TOKEN=your_xano_metadata_api_token_here

# Workspace ID — the Xano workspace to use (the 'Reform' workspace)
XANO_WORKSPACE_ID=2

# --------------------------------------------------
# Local LLM — OpenAI-compatible server (required)
# --------------------------------------------------
# Reform uses a local LLM for ALL AI features:
#   - AI Form Generator (prompt → flowchart)
#   - Submission Insights (summarize submissions)
#   - Smart Field Suggestions (label → config)
#   - Conversational Form (option matching)
#   - Smart Routing (plain English rule evaluation)
#   - Auto-Translation (translate field labels)
#   - Drop-off Analytics (UX suggestions)
#   - PDF Analyst Notes (submission summaries)
#
# Supported backends:
#   Ollama:     http://localhost:11434/v1  (recommended, default)
#   LM Studio:  http://localhost:1234/v1
#   vLLM:       http://localhost:8000/v1
#   Any OpenAI-compatible server
#
# Quick start:
#   ./scripts/setup-local-llm.sh          # Install Ollama + pull model
#   ./scripts/setup-local-llm.sh --status # Check if server is running
#
# Tested models (via Ollama):
#   qwen2.5-coder:7b   — Fast, good JSON output (recommended)
#   qwen2.5-coder:14b  — Better quality, slower
#   llama3.2           — Good general purpose
#   mistral            — Fast, good for code

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b

# --------------------------------------------------
# Local ASR — Voice Transcription (optional)
# --------------------------------------------------
# Enables the 🎤 mic button in conversational forms.
# When enabled, users can speak their answers instead of typing.
#
# How it works:
#   1. Browser records audio via MediaRecorder (WebM/Opus)
#   2. Audio is sent to POST /api/forms/[id]/voice-transcribe
#   3. Reform forwards audio to the ASR server at ASR_BASE_URL
#   4. ASR server transcribes audio → returns text
#   5. Text flows through the conversational form extraction pipeline
#
# Setup (one-time):
#   ./scripts/start-whisper.sh          # Start Whisper server
#   ./scripts/start-whisper.sh --stop   # Stop server
#   ./scripts/start-whisper.sh --status # Check status
#
# Supported ASR backends:
#   faster-whisper server (default) — http://localhost:9000
#   whisper.cpp server              — http://localhost:9000
#   OpenAI Whisper API              — https://api.openai.com/v1
#
# Model options (for faster-whisper):
#   tiny    — ~75MB,  fast, lower accuracy
#   base    — ~150MB, good balance (default)
#   small   — ~500MB, better accuracy
#   medium  — ~1.5GB, high accuracy
#   large-v3 — ~3GB,  best accuracy
#
# Environment variables:
#   ASR_BASE_URL  — Server endpoint (default: http://localhost:9000)
#   ASR_API_KEY   — API key (optional for local servers)
#   ASR_PORT      — Server port (default: 9000, used by start-whisper.sh)
#   WHISPER_MODEL — Model name (default: base, used by start-whisper.sh)
#   WHISPER_DEVICE — cpu or cuda (default: cpu)

ASR_BASE_URL=http://localhost:9000
ASR_API_KEY=
# ASR_PORT=9000
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu

# --------------------------------------------------
# Legacy (no longer used)
# --------------------------------------------------
# DATABASE_URL="postgresql://reform:reform_password@localhost:5432/reform?schema=public"
#
# Note: Authentication uses the app's own auth system (email/password + guest).
